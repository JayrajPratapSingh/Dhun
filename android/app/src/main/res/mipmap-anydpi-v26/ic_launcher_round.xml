<?xml version="1.0" encoding="utf-8"?>
<!-- Same layers as ic_launcher; the manifest references this for launchers that
     ask for a round icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_gold"
            android:inset="10%" />
    </foreground>
</adaptive-icon>
